<resources>

    <style name="Base.Theme.Android1" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/fondoApp</item>
        <item name="colorPrimary">@color/acento</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSurface">@color/fondoTarjeta</item>
        <item name="android:textColorPrimary">@color/textoPrimario</item>
        <item name="android:textColorSecondary">@color/textoSecundario</item>
    </style>

    <style name="Theme.Android1" parent="Base.Theme.Android1" />

    <style name="BotonPrimario" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/boton_primario</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BotonSecundario" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/boton_secundario</item>
        <item name="android:textColor">@color/textoPrimario</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CampoTexto" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/campo_texto</item>
        <item name="android:textColor">@color/textoPrimario</item>
        <item name="android:textColorHint">@color/textoTenue</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="RotuloCampo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/textoSecundario</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

</resources>