<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/rotuloZona"
            style="@style/RotuloCampo"
            android:layout_marginTop="4dp"
            android:text="@string/form_zona"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Spinner
            android:id="@+id/spinnerFormZona"
            style="@style/CampoTexto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rotuloZona" />

        <TextView
            android:id="@+id/rotuloAutor"
            style="@style/RotuloCampo"
            android:layout_marginTop="20dp"
            android:text="@string/form_autor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinnerFormZona" />

        <EditText
            android:id="@+id/campoAutor"
            style="@style/CampoTexto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="name"
            android:hint="@string/form_autor_hint"
            android:inputType="textPersonName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rotuloAutor" />

        <TextView
            android:id="@+id/rotuloCategoria"
            style="@style/RotuloCampo"
            android:layout_marginTop="20dp"
            android:text="@string/form_categoria"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/campoAutor" />

        <Spinner
            android:id="@+id/spinnerFormCategoria"
            style="@style/CampoTexto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rotuloCategoria" />

        <TextView
            android:id="@+id/rotuloMensaje"
            style="@style/RotuloCampo"
            android:layout_marginTop="20dp"
            android:text="@string/form_mensaje"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinnerFormCategoria" />

        <EditText
            android:id="@+id/campoMensaje"
            style="@style/CampoTexto"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="@string/form_mensaje_hint"
            android:inputType="textMultiLine"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rotuloMensaje" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>