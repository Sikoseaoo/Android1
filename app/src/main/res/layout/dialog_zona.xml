<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <EditText
            android:id="@+id/campoZonaNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:background="@drawable/campo_texto"
            android:hint="@string/form_zona_nombre_hint"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:textColor="@color/textoPrimario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/rotuloZonaCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/form_categoria"
            android:textColor="@color/textoSecundario"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/campoZonaNombre" />

        <Spinner
            android:id="@+id/spinnerZonaCategoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/campo_texto"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rotuloZonaCategoria" />

        <EditText
            android:id="@+id/campoZonaDescripcion"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/campo_texto"
            android:gravity="top"
            android:hint="@string/form_zona_descripcion_hint"
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:textColor="@color/textoPrimario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinnerZonaCategoria" />

        <EditText
            android:id="@+id/campoZonaLatitud"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="6dp"
            android:autofillHints=""
            android:background="@drawable/campo_texto"
            android:hint="@string/form_latitud_hint"
            android:inputType="numberDecimal|numberSigned"
            android:padding="14dp"
            android:textColor="@color/textoPrimario"
            app:layout_constraintEnd_toStartOf="@id/campoZonaLongitud"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/campoZonaDescripcion" />

        <EditText
            android:id="@+id/campoZonaLongitud"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:autofillHints=""
            android:background="@drawable/campo_texto"
            android:hint="@string/form_longitud_hint"
            android:inputType="numberDecimal|numberSigned"
            android:padding="14dp"
            android:textColor="@color/textoPrimario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/campoZonaLatitud"
            app:layout_constraintTop_toTopOf="@id/campoZonaLatitud" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>